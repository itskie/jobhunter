# ==============================================================================
# JobHunter Environment Variables
# Copy this file to .env and fill in your details:
#   cp .env.example .env
# ==============================================================================

# Candidate Profile Details
CANDIDATE_NAME="Your Full Name"
CANDIDATE_EMAIL="your_email@gmail.com"
CANDIDATE_PHONE="+91 9876543210"
CANDIDATE_GITHUB="https://github.com/yourusername"
CANDIDATE_LINKEDIN="https://linkedin.com/in/yourprofile"

# Path to your PDF Resume (or keep a resume.pdf in the project folder)
RESUME_PATH="/path/to/your/resume.pdf"

# Google SMTP Credentials (Generate 16-character App Password at https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
